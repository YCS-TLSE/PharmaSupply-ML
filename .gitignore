# =============================================================================
# PharmaSupply-ML: Git exclusions
# =============================================================================
# Ignore local environments, caches, secrets, generated data/artifacts and
# runtime logs. The .env.example template remains tracked.
# =============================================================================

# Environnements virtuels & Conda
.venv/
venv/
*.egg-info/

# Cache Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Données locales (CSV, Parquet, bases SQLite locales)
*.csv
*.parquet
*.db
*.sqlite

# Fichiers IDE & Système
.vscode/
.idea/
.DS_Store

# Configuration locale VS Code & Workspace
*.code-workspace
.vscode/

# Configuration & Variables d'environnement sensibles
.env
.env.*
!.env.example

# Documentation locale / Notes
logBook/

# MLflow local tracking store
mlruns/

# Production drift log (runtime artifact)
reports/prediction_log.jsonl
reports/production_drift_report.html