# =============================================================================
# PharmaSupply-ML: environment template
# =============================================================================
# Copy this file to .env and fill in secrets. Never commit the real .env.
# The application loads it from the repository root via src.config.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pharmasupply_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- API security -----------------------------------------------------------
# Leave empty to disable API-key authentication (local development only).
API_KEY=
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PREDICT=60/minute
RATE_LIMIT_ALERTS=120/minute

# --- MLflow tracking & registry --------------------------------------------
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=pharmasupply-demand
MLFLOW_REGISTERED_MODEL_NAME=PharmaSupplyDemandForecaster

# --- Observability & production drift --------------------------------------
PREDICTION_LOG_PATH=reports/prediction_log.jsonl
PRODUCTION_DRIFT_MIN_SAMPLES=30

# --- SMTP drift notifications ----------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=mlops-alert@pharmasupply.com
RECEIVER_EMAIL=support-tech@pharmasupply.com
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=5
MODEL_STATUS_POLL_SECONDS=30
